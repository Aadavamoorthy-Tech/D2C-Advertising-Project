# Copy to local.env (gitignored) and fill in. Real environment variables override this file.
# Never commit local.env and never paste these values into chat.
RENDER_API_KEY=REPLACE_WITH_RENDER_API_KEY
RENDER_SERVICE_ID=srv-REPLACE_WITH_BACKEND_SERVICE_ID
BACKEND_URL=https://REPLACE_WITH_BACKEND.onrender.com
HELPER_TOKEN=REPLACE_WITH_THE_SAME_LONG_RANDOM_HELPER_TOKEN_AS_RENDER

# Optional
# NGROK_PATH=C:\Path\To\ngrok.exe
# NGROK_INSPECT_ADDRS=127.0.0.1:4040,127.0.0.1:4041
# EXASOL_LOCAL_HOST=127.0.0.1
